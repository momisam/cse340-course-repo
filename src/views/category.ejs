<%- include('partials/header.ejs') %>

<main>

<h1><%= category.name %></h1>

<ul>
  <% projects.forEach(project => { %>
    <li>
      <a href="/project/<%= project.project_id %>">
        <%= project.title %>
      </a>
    </li>
  <% }); %>
</ul>
<p><a href="/edit-category/<%= category.category_id %>" class="btn">Edit Category</a></p>
</main>


<%- include('partials/footer.ejs') %>